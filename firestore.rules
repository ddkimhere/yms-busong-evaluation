rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ddkim1984@gmail.com';
    }

    function isApprovedStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function canUseEvaluation() {
      return isAdmin() || isApprovedStaff();
    }

    match /staff/{staffId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == staffId);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read, create, update: if canUseEvaluation();
      allow delete: if false;

      match /evaluations/{evaluationId} {
        allow read, create, update: if canUseEvaluation();
        allow delete: if false;
      }
    }

    match /teachers/{teacherId} {
      allow read, create, update: if canUseEvaluation();
      allow delete: if false;
    }
  }
}
